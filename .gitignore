# Local .terraform directories
**/.terraform/*

# .tfstate files (contain sensitive infrastructure secrets)
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data,
# except for the example template
*.tfvars
*.tfvars.json
!terraform.tfvars.example

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files and SARIF local artifacts
.terraformrc
terraform.rc
results.sarif

# OS files
.DS_Store
Thumbs.db